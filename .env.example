# URL of the INJ Pass embed page provided by inj-pass-frontend.
# Must point at the /embed route of the *running* inj-pass-frontend instance.
# inj-pass-frontend defaults to port 3000; this game runs on 3002.
NEXT_PUBLIC_INJPASS_EMBED_URL=http://localhost:3000/embed

# --- Game backend (built-in Next route handlers + Prisma + Postgres) ---
# Postgres connection string for the per-wallet cloud save.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bankrupt_elon?schema=public
# Secret used to sign session JWTs (use a long random value in production).
JWT_SECRET=change-me-to-a-long-random-secret
